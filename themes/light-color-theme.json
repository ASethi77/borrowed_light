  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#52565e"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#704579"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#2f5e56"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#465674"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6d5127"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5a4e7e"
      }
    },
    {
      "scope": [
        "variable",
        "punctuation",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#191d24"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#704579"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "markup.link"
      ],
      "settings": {
        "foreground": "#6d5127"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#a22629"
      }
    }
  ],
  "semanticTokenColors": {
    "*": "#191d24",
    "comment": "#52565e",
    "string": "#2f5e56",
    "number": "#465674",
    "keyword": "#704579",
    "operator": "#191d24",
    "function": "#6d5127",
    "method": "#6d5127",
    "type": "#5a4e7e",
    "class": "#5a4e7e",
    "interface": "#5a4e7e",
    "enum": "#5a4e7e",
    "typeParameter": "#5a4e7e",
    "namespace": "#5a4e7e",
    "struct": "#5a4e7e",
    "variable": "#191d24",
    "parameter": "#191d24",
    "property": "#191d24",
    "enumMember": "#465674",
    "variable.readonly": "#465674",
    "decorator": "#6d5127",
    "regexp": "#2f5e56"
  }
