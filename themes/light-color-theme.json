  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#224e66"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#005445"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#005259"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#004f70"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2c4689"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#533c84"
      }
    },
    {
      "scope": [
        "variable",
        "punctuation",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#002030"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#005445"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "markup.link"
      ],
      "settings": {
        "foreground": "#2c4689"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#93141d"
      }
    }
  ],
