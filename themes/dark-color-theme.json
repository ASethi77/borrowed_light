  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8d929b"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#be8fc8"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#84b5ab"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8c9fc0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c0a175"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#a397cc"
      }
    },
    {
      "scope": [
        "variable",
        "punctuation",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#d2d8e1"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#be8fc8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "markup.link"
      ],
      "settings": {
        "foreground": "#c0a175"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ea6a64"
      }
    }
  ],
  "semanticTokenColors": {
    "*": "#d2d8e1",
    "comment": "#8d929b",
    "string": "#84b5ab",
    "number": "#8c9fc0",
    "keyword": "#be8fc8",
    "operator": "#d2d8e1",
    "function": "#c0a175",
    "method": "#c0a175",
    "type": "#a397cc",
    "class": "#a397cc",
    "interface": "#a397cc",
    "enum": "#a397cc",
    "typeParameter": "#a397cc",
    "namespace": "#a397cc",
    "struct": "#a397cc",
    "variable": "#d2d8e1",
    "parameter": "#d2d8e1",
    "property": "#d2d8e1",
    "enumMember": "#8c9fc0",
    "variable.readonly": "#8c9fc0",
    "decorator": "#c0a175",
    "regexp": "#84b5ab"
  }
