{
  "name": "wallpaper-paste",
  "displayName": "Wallpaper Paste",
  "description": "Generate a readable VS Code theme from your GNOME desktop wallpaper",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wallpaper-paste.sync",
        "title": "Wallpaper Paste: Sync Theme from Wallpaper"
      },
      {
        "command": "wallpaper-paste.report",
        "title": "Wallpaper Paste: Show Palette and Contrast Report"
      },
      {
        "command": "wallpaper-paste.restore",
        "title": "Wallpaper Paste: Restore Previous Theme"
      }
    ],
    "themes": [
      {
        "label": "Wallpaper Paste Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-color-theme.json"
      },
      {
        "label": "Wallpaper Paste Light",
        "uiTheme": "vs",
        "path": "./themes/light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Wallpaper Paste",
      "properties": {
        "wallpaper-paste.harmony": {
          "type": "string",
          "enum": [
            "analogous",
            "monochromatic",
            "triad",
            "complementary",
            "compound",
            "shades"
          ],
          "default": "analogous",
          "scope": "application",
          "description": "Harmony recipe used to derive the wallpaper palette."
        },
        "wallpaper-paste.appearance": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "desktop"
          ],
          "default": "dark",
          "scope": "application",
          "description": "Generated theme appearance. Desktop follows GNOME light/dark preference."
        },
        "wallpaper-paste.autoSync": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Monitor wallpaper changes while a Wallpaper Paste theme is selected. Sync manually first to select it."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:host",
    "test:unit": "npm run compile && npm run compile-tests && node --test out/test/unit/*.test.js",
    "test:host": "vscode-test",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license --out wallpaper-paste-0.0.1.vsix"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "extensionKind": [
    "ui"
  ],
  "publisher": "wallpaper-paste-local"
}
