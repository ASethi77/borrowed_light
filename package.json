{
  "name": "borrowed-light",
  "displayName": "Borrowed Light",
  "description": "Generate harmonious, readable VS Code themes from your desktop wallpaper",
  "version": "0.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/ASethi77/borrowed_light.git"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "borrowed-light.sync",
        "title": "Borrowed Light: Sync Theme from Wallpaper"
      },
      {
        "command": "borrowed-light.report",
        "title": "Borrowed Light: Show Palette and Contrast Report"
      },
      {
        "command": "borrowed-light.restore",
        "title": "Borrowed Light: Restore Previous Theme"
      },
      {
        "command": "borrowed-light.preview",
        "title": "Borrowed Light: Preview Color Schemes"
      }
    ],
    "themes": [
      {
        "label": "Borrowed Light (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-color-theme.json",
        "id": "Borrowed Light (Dark)"
      },
      {
        "label": "Borrowed Light (Light)",
        "uiTheme": "vs",
        "path": "./themes/light-color-theme.json",
        "id": "Borrowed Light (Light)"
      }
    ],
    "configuration": {
      "title": "Borrowed Light",
      "properties": {
        "borrowed-light.harmony": {
          "type": "string",
          "enum": [
            "analogous",
            "monochromatic",
            "triad",
            "complementary",
            "compound",
            "shades"
          ],
          "default": "analogous",
          "scope": "application",
          "description": "Harmony recipe used to derive the wallpaper palette."
        },
        "borrowed-light.appearance": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "desktop"
          ],
          "default": "dark",
          "scope": "application",
          "description": "Generated theme appearance. Desktop follows the local platform's light/dark preference."
        },
        "borrowed-light.autoSync": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Monitor wallpaper changes while a Borrowed Light theme is selected. Sync manually first to select it."
        },
        "borrowed-light.primaryDark": {
          "type": "string",
          "enum": [
            "automatic",
            "wallpaper-1",
            "wallpaper-2",
            "wallpaper-3",
            "wallpaper-4",
            "wallpaper-5",
            "wallpaper-6",
            "wallpaper-7",
            "wallpaper-8",
            "harmony-1",
            "harmony-2",
            "harmony-3",
            "harmony-4",
            "harmony-5"
          ],
          "default": "automatic",
          "scope": "application",
          "description": "Primary surface/accent color for dark mode. Wallpaper slots follow extracted weight order; harmony slots follow the selected rule. Missing wallpaper slots fall back to automatic. Use the preview toolbar to cycle colors."
        },
        "borrowed-light.primaryLight": {
          "type": "string",
          "enum": [
            "automatic",
            "wallpaper-1",
            "wallpaper-2",
            "wallpaper-3",
            "wallpaper-4",
            "wallpaper-5",
            "wallpaper-6",
            "wallpaper-7",
            "wallpaper-8",
            "harmony-1",
            "harmony-2",
            "harmony-3",
            "harmony-4",
            "harmony-5"
          ],
          "default": "automatic",
          "scope": "application",
          "description": "Primary surface/accent color for light mode. Wallpaper slots follow extracted weight order; harmony slots follow the selected rule. Missing wallpaper slots fall back to automatic. Use the preview toolbar to cycle colors."
        },
        "borrowed-light.syntaxStyle": {
          "type": "string",
          "enum": [
            "mellow",
            "balanced",
            "vibrant",
            "vibrant-alt"
          ],
          "enumDescriptions": [
            "Soft harmony colors with neutral identifiers.",
            "Moderately saturated harmony colors with neutral identifiers.",
            "Distinct wallpaper and harmony-derived accents for syntax families, including identifiers, parameters and properties.",
            "The vibrant palette with a different assignment to syntax categories."
          ],
          "default": "balanced",
          "scope": "application",
          "description": "Syntax highlighting style. Cycle live using the keyword button in the wallpaper preview."
        },
        "borrowed-light.platformProvider": {
          "type": "string",
          "enum": [
            "auto",
            "windows",
            "macos",
            "linux-gnome"
          ],
          "default": "auto",
          "scope": "application",
          "description": "Wallpaper provider. Auto detects the local OS and Linux desktop. Override for ambiguous Linux sessions; providers must match the host OS."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "borrowed-light.python-html",
        "path": "./syntaxes/python-html.tmLanguage.json",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "source.js": "javascript",
          "source.css": "css"
        },
        "tokenTypes": {
          "meta.embedded.block.html": "other"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:host",
    "test:unit": "npm run compile && npm run compile-tests && node --test out/test/unit/*.test.js",
    "test:host": "vscode-test",
    "vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license --out borrowed-light-0.0.9.vsix"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "extensionKind": [
    "ui"
  ],
  "publisher": "borrowed-light-local"
}
